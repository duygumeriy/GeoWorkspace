# ---------------------------------------------------------------------------
# StajProject (GitHub: GeoWorkspace) — root ignore rules
# Nested frontend/.gitignore and backend/.gitignore stay in place; this file
# holds the repository-wide rules.
# ---------------------------------------------------------------------------

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*
# NOTE: the classic "Icon?" pattern is deliberately omitted — this filesystem is
# case-insensitive (core.ignorecase=true), so it also matches source folders
# named "icons/".

# --- IDE / local tooling ---
.idea/
.vscode/
.vs/
.claude/
*.swp
*.swo

# --- Node / React / Vite ---
node_modules/
dist/
dist-ssr/
build/
.vite/
coverage/
playwright-report/
test-results/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- .NET ---
bin/
obj/
*.user
*.suo
*.userprefs
TestResults/
*.dll
*.pdb
artifacts/

# --- Secrets ---
# Real credentials live in dotnet user-secrets / environment variables.
# See backend/README-SECRETS.md.
.env
.env.*
secrets.json
appsettings.Local.json
appsettings.*.Local.json

# Safe, secret-free templates and local dev config are still tracked:
!.env.example
# frontend/.env.development holds only VITE_API_BASE_URL (a localhost URL) and
# is required for `npm run dev` to reach the API. Verified to contain no
# credentials. Remove this negation if that ever stops being true.
!.env.development

# Keys and certificates — never commit
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.jks
*.keystore

# Development e-mail sink: contains confirmation and password-reset TOKENS.
dev-emails/

# Local OSRM configuration, map extracts, and generated multi-gigabyte routing artifacts.
tools/osrm/.env
tools/osrm/**/*.osm.pbf
tools/osrm/**/*.osrm
tools/osrm/**/*.osrm.*
!tools/osrm/docker-compose.osrm.yml
tools/osrm/data/*
!tools/osrm/data/.gitignore

# --- Project-local references and report outputs (not application source) ---
# Kept on disk, excluded from source control.
StajProject-UI-References/
staj-raporu-ciktilari/

# MS Office lock/temp files
~$*
