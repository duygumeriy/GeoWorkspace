# Directory containing the source PBF and the generated DRIVING routing files.
# Unchanged from the single-profile setup, so an existing driving dataset keeps
# working without re-extraction.
OSRM_DATA_DIR=./data

# Dataset basename: expects <name>.osm.pbf and generates <name>.osrm*.
# The same source PBF feeds all three profiles.
OSRM_DATASET=turkey-latest

# Host ports mapped to each container's fixed internal port 5000.
#
# Driving is deliberately overridable and installations differ: the compose
# default is 5000, while this project's established local setup runs it on
# 5001. The optional profiles therefore default to 5002/5003, which stay
# collision-free under EITHER driving port. Compose does not reject duplicate
# published ports when resolving config — only the container start fails — so
# pick distinct values here.
OSRM_HOST_PORT=5001
OSRM_WALKING_HOST_PORT=5002
OSRM_CYCLING_HOST_PORT=5003

# Generated artifacts per optional profile. These MUST NOT point at
# OSRM_DATA_DIR: osrm-extract would overwrite the driving dataset, and the
# server would then answer walking requests with driving geometry.
OSRM_WALKING_DATA_DIR=./data/walking
OSRM_CYCLING_DATA_DIR=./data/cycling
