<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StajProject.Domain\StajProject.Domain.csproj" />
    <ProjectReference Include="..\StajProject.Application\StajProject.Application.csproj" />
  </ItemGroup>

  <!-- Identity/authorization altyapısının ASP.NET Core tipleri paylaşımlı
       framework'te yer alır. Host zaten Microsoft.AspNetCore.App üzerinde
       çalıştığı için bu derleme zamanı referansı çıktıya dosya eklemez. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="8.0.8" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
  </ItemGroup>

  <!-- İl/bölge ilişkisinin TEK kaynağı frontend'in yönetici kapsam
       seçicisinde kullandığı veri kümesidir. Dosya derlemeye gömülür;
       publish dizininde kaynak kod yoluna bağımlı kalınmaz. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../frontend/src/map/data/turkeyProvinces.json"
                      LogicalName="StajProject.Infrastructure.Data.turkeyProvinces.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <!-- Arama sorgusunun SQL'e ÇEVRİLDİĞİNİ doğrulayan testler için
       (bkz. PoiService.BuildSearchQuery). Üretim davranışını değiştirmez. -->
  <ItemGroup>
    <InternalsVisibleTo Include="StajProject.Auth.Tests" />
  </ItemGroup>

</Project>
