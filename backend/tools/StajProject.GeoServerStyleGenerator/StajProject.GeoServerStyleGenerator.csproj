<Project Sdk="Microsoft.NET.Sdk">

  <!-- GELİŞTİRİCİ ARACI — üretim çalışma zamanının parçası DEĞİLDİR.
       DI'a kaydedilmez, API açılışında çalışmaz, veritabanına ya da
       GeoServer'a bağlanmaz, ağ erişimi istemez. Tek girdisi Domain
       katmanındaki kanonik taksonomi, tek çıktısı depodaki dosyalardır. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StajProject.GeoServerStyleGenerator</RootNamespace>
    <AssemblyName>StajProject.GeoServerStyleGenerator</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StajProject.Domain\StajProject.Domain.csproj" />
  </ItemGroup>

  <!-- Sürüklenme (drift) testleri üretecin PLANINI doğrudan okur. Şablonu test
       içinde yeniden yazmak, ikinci bir gerçek kaynağı demek olurdu. -->
  <ItemGroup>
    <InternalsVisibleTo Include="StajProject.Auth.Tests" />
  </ItemGroup>

</Project>
