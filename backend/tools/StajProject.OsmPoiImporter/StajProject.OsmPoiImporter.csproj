<Project Sdk="Microsoft.NET.Sdk">

  <!-- GELİŞTİRİCİ ARACI — üretim çalışma zamanının parçası DEĞİLDİR.
       API'nin DI kabına kaydedilmez, açılışta çalışmaz ve HİÇBİR ağ erişimi
       yapmaz: girdi her zaman elle verilen YEREL bir dosya yoludur. Tek yazdığı
       tablo `analysis_poi`dir; normal POI envanterine dokunmaz.

       Yeni bir NuGet bağımlılığı YOKTUR: OSM XML, BCL'deki XmlReader ile
       akış hâlinde okunur (gerekçe için bkz. docs/osm-poi-import.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StajProject.OsmPoiImporter</RootNamespace>
    <AssemblyName>StajProject.OsmPoiImporter</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StajProject.Infrastructure\StajProject.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Eşleme ve içe aktarma çekirdeği testlerden doğrudan sınanır; kurallar
       test içinde yeniden yazılsaydı ikinci bir gerçek kaynak doğardı. -->
  <ItemGroup>
    <InternalsVisibleTo Include="StajProject.Auth.Tests" />
  </ItemGroup>

</Project>
